{
  "name": "@skillrouter/aragon-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Skill Router Node sidecar gateway: hosts the AragonAgent engine, exposes platform tools (sr_*) and streams AgentEvents to the Python platform over SSE.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/src/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "engine-host": "node dist/src/engine-host.js"
  },
  "dependencies": {
    "@aragon-agent/core": "0.2.34",
    "ajv": "^8.17.1",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
