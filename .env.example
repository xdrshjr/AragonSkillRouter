# ---------------------------------------------------------------------------
# Skill Router — deployment configuration template.
# Copy to `.env` and fill in. Never commit a filled-in copy.
# Every value is optional; the defaults are development-safe.
# ---------------------------------------------------------------------------

# development | staging | production
SR_ENVIRONMENT=production
# Public URL users and external agents reach (behind your TLS reverse proxy).
SR_PUBLIC_BASE_URL=https://skillrouter.example.com
# Where the API listens inside the deployment (used for internal links only).
SR_BACKEND_BASE_URL=http://api:8000

# --- storage ---------------------------------------------------------------
# Persistent volume. Holds the SQLite database, uploads, artifacts, backups.
SR_DATA_DIR=/data
# SR_DATABASE_PATH=/data/skillrouter.db
# Master keyring file. MUST live outside the database and be backed up
# separately. Alternatively supply keys via SR_MASTER_KEYS (below).
# SR_MASTER_KEY_FILE=/data/keys/master.keyring.json
# Container-friendly alternative: comma-separated base64url 32-byte keys.
# SR_MASTER_KEYS=k1:<base64url-32-bytes>,k2:<base64url-32-bytes>
# SR_MASTER_KEY_ACTIVE=k2

# --- first-run admin (used once, only while no user exists) ----------------
SR_INITIAL_ADMIN_USERNAME=admin
# Choose a real password here; the first sign-in must still change it.
SR_INITIAL_ADMIN_PASSWORD=change-this-before-first-boot

# --- session / cookies -----------------------------------------------------
SR_SESSION_TTL_MINUTES=480
SR_SESSION_IDLE_TIMEOUT_MINUTES=120
SR_COOKIE_SECURE=true
# SR_COOKIE_DOMAIN=skillrouter.example.com
# CORS/origin allowlist for the browser app.
SR_TRUSTED_ORIGINS=https://skillrouter.example.com

# --- login throttling ------------------------------------------------------
SR_LOGIN_MAX_ATTEMPTS=5
SR_LOGIN_WINDOW_MINUTES=15
SR_LOGIN_LOCKOUT_MINUTES=15

# --- outbound network policy (API tests, web imports) ----------------------
# Explicit allowlist for internal endpoints. Private/loopback/metadata targets
# are refused unless the host appears here.
SR_OUTBOUND_ALLOWED_HOSTS=
SR_OUTBOUND_ALLOW_PRIVATE=false
# Transparent-proxy (Clash/Surge "fake-IP") handling:
#   auto  → detect at startup whether every hostname resolves into 198.18.0.0/15
#           and, only then, exempt that range (default; correct for both a normal
#           server and a developer machine behind a fake-IP proxy)
#   allow → always exempt 198.18.0.0/15
#   deny  → never exempt it, even behind such a proxy
SR_OUTBOUND_FAKE_IP_MODE=auto
# Hard override for the range; wins over the mode when set (true/false).
# SR_OUTBOUND_ALLOW_FAKE_IP=
SR_OUTBOUND_TIMEOUT_SECONDS=20
SR_OUTBOUND_MAX_REDIRECTS=3
SR_OUTBOUND_MAX_RESPONSE_BYTES=8388608

# --- uploads and artifacts -------------------------------------------------
SR_MAX_UPLOAD_BYTES=26214400
SR_FILE_RETENTION_DAYS=30

# --- worker ----------------------------------------------------------------
SR_WORKER_CONCURRENCY=4
SR_WORKER_LEASE_SECONDS=120
SR_WORKER_POLL_SECONDS=1.0
SR_TASK_DEFAULT_TIMEOUT_SECONDS=300

# --- AragonAgent sidecar ---------------------------------------------------
SR_ARAGON_SIDECAR_URL=http://aragon-sidecar:7317
# Shared secret between API and sidecar. Generate with: openssl rand -hex 32
SR_ARAGON_SIDECAR_TOKEN=
SR_ARAGON_REPO_URL=https://github.com/xdrshjr/AragonAgent.git
SR_ARAGON_NPM_PACKAGE=@aragon-agent/core
SR_ARAGON_CLI_PACKAGE=@aragon-agent/cli
# stable | branch
SR_ARAGON_UPGRADE_CHANNEL=stable
SR_ARAGON_TRACK_BRANCH=main
# Commit the adapter was written and verified against.
SR_ARAGON_ALIGNED_COMMIT=c8b0e3df60319b81b529310e4d4f8d545c70c525
SR_ARAGON_ALIGNED_CLI_VERSION=0.6.34
SR_ARAGON_ALIGNED_CORE_VERSION=0.2.50
# manual | auto
SR_ARAGON_UPGRADE_POLICY=manual
