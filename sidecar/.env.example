# AragonAgent sidecar — environment template.
# Copy to sidecar/.env (or export in the process manager) and fill in the token.
# The backend reads the SAME values from the repo-root .env.

# ---- required ---------------------------------------------------------------
# Shared secret. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The backend must be given the identical value as SR_ARAGON_SIDECAR_TOKEN.
SR_ARAGON_SIDECAR_TOKEN=

# ---- listener (loopback only; a non-loopback host is refused at boot) -------
SR_ARAGON_SIDECAR_HOST=127.0.0.1
SR_ARAGON_SIDECAR_PORT=7317

# ---- upstream engine / upgrade channel --------------------------------------
SR_ARAGON_REPO_URL=https://github.com/xdrshjr/AragonAgent.git
SR_ARAGON_UPGRADE_CHANNEL=stable
SR_ARAGON_TRACK_BRANCH=main
# Set this to the commit this build was produced from; reported by /health.
SR_ARAGON_ENGINE_COMMIT=

# ---- optional default model -------------------------------------------------
# Only used when a POST /sessions request omits model{}. The platform normally
# sends the model resolved from an active LLM credential, so leaving these empty
# is correct for a platform-driven deployment.
SR_ARAGON_DEFAULT_PROVIDER_ID=
SR_ARAGON_DEFAULT_MODEL_ID=
# OpenAI-compatible gateways only, e.g. https://zenmux.ai/api/v1
SR_ARAGON_DEFAULT_BASE_URL=

# ---- limits -----------------------------------------------------------------
SR_ARAGON_MAX_SESSIONS=32
SR_ARAGON_EVENT_BUFFER=2000
SR_ARAGON_TOOL_TIMEOUT_MS=120000
SR_ARAGON_LLM_TIMEOUT_MS=300000
SR_ARAGON_IDLE_TIMEOUT_MS=300000
SR_ARAGON_MAX_TOOL_OUTPUT_CHARS=4000
SR_ARAGON_STOP_SETTLE_MS=10000
SR_ARAGON_RELEASE_TIMEOUT_MS=15000
SR_ARAGON_SSE_KEEPALIVE_MS=15000
# SR_ARAGON_MAX_TOKENS=8192
