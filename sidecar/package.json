{
  "name": "skill-router-aragon-sidecar",
  "version": "1.0.0",
  "private": true,
  "description": "Node sidecar embedding @aragon-agent/core for Skill Router. The only process that imports the agent engine.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "npm run build && node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@aragon-agent/core": "0.2.50"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  }
}
